# ============================================
# Data Directory - Ignore all by default
# ============================================
data/**/*

# Allow only specific files in data directories
!data/
!data/**/
!data/**/*.py
!data/**/train.txt
!data/**/valid.txt
!data/**/test.txt
!data/**/entity2id.txt
!data/**/relation2id.txt
!data/**/stat.txt

# ============================================
# Python Cache & Artifacts
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================
# Virtual Environments
# ============================================
env/
venv/
ENV/
env.bak/
venv.bak/

# ============================================
# IDE & Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# Jupyter Notebooks - Cache only
# ============================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/
